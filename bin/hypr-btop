#!/bin/sh
set -eu

terminal="${TERMINAL:-alacritty}"

if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  monitor="$(hyprctl monitors -j 2>/dev/null | jq -r '([.[] | select(.focused == true)][0] // .[0]) | [.width, .height, (.scale // 1)] | @tsv' 2>/dev/null || true)"
else
  monitor=""
fi

if [ -n "$monitor" ]; then
  set -- $monitor
  width="$1"
  height="$2"
  scale="${3:-1}"
  size="$(awk -v w="$width" -v h="$height" -v s="$scale" 'BEGIN {
    if (s <= 0) s = 1;
    printf "%d %d", (w / s) * 0.8, (h / s) * 0.8
  }')"
else
  size="1200 800"
fi

case "$(basename "$terminal")" in
  alacritty)
    command="$terminal --title dotfiles-btop -e btop"
    ;;
  kitty)
    command="$terminal --title dotfiles-btop -e btop"
    ;;
  *)
    command="$terminal -e btop"
    ;;
esac

hyprctl dispatch exec "[float; size $size; center] $command"
